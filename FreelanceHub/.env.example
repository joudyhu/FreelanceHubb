# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3001

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freelancehub?schema=public

# JWT - replace both secrets with long random values before deployment
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Redis (optional for local development; required for shared production cache/queues)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Uploads
UPLOAD_DIR=uploads
MAX_PROFILE_IMAGE_BYTES=2097152
MAX_PROJECT_FILE_BYTES=5242880
MAX_DELIVERY_FILE_BYTES=20971520

# Mail (optional; configure SMTP to send real emails)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="FreelanceHub <no-reply@freelancehub.local>"

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Platform policy
PLATFORM_COMMISSION_PERCENT=10
